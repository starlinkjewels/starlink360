# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored (matches the *.local pattern in .gitignore) —
# never commit real secrets.

# Sarvam AI API key, used server-side only by src/routes/api/chat.ts to
# call the sarvam-105b-conversations model. Deliberately NOT prefixed with
# VITE_ — that prefix is what makes a variable get bundled into client-side
# code, and this key must never reach the browser. Get it from
# https://dashboard.sarvam.ai.
SARVAM_API_KEY=

# Passphrases that reveal the upload button via ?key=<passphrase>,
# comma-separated, case-insensitive. Checked server-side only by
# src/lib/uploadAccess.ts, so the list never reaches the browser. Leave it
# empty and the upload button is hidden for everyone. Set it in the hosting
# platform's environment too (Cloudflare / Vercel / Lovable), not just here.
UPLOAD_KEYS=
